{
	"name": "fuyao-homepage",
	"private": true,
	"version": "27.0.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/prepare-build-inputs.js --mode=development && vite dev --mode dev",
		"inputs:prepare": "node scripts/prepare-build-inputs.js --mode=ci",
		"inputs:prepare:production": "node scripts/prepare-build-inputs.js --mode=production",
		"version:show": "node scripts/update-version.js show",
		"version:patch": "node scripts/update-version.js patch",
		"version:minor": "node scripts/update-version.js minor",
		"version:major": "node scripts/update-version.js major",
		"version:set": "node scripts/update-version.js set",
		"version:sync": "node scripts/update-version.js sync",
		"build:bump": "node scripts/update-version.js build",
		"build:set": "node scripts/update-version.js build-set",
		"train:set": "node scripts/update-version.js train-set",
		"build": "node scripts/prepare-build-inputs.js --mode=ci && vite build && node tests/verify-build.js && node scripts/validate-deployment.js --phase=build",
		"build:production": "node scripts/prepare-build-inputs.js --mode=production && vite build && node tests/verify-build.js && node scripts/validate-deployment.js --phase=build",
		"preview": "vite preview",
		"prepare": "node scripts/prepare-build-inputs.js --mode=ci && svelte-kit sync",
		"check": "node scripts/prepare-build-inputs.js --mode=ci && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node scripts/prepare-build-inputs.js --mode=ci && node --test tests/*.test.js",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen-blog": "node scripts/prepare-build-inputs.js --mode=development",
		"gen-album": "node scripts/generate-album-index.js --no-rename",
		"gen-album:import": "node scripts/generate-album-index.js",
		"gen-album:public": "node scripts/generate-album-index.js --no-rename --strip-gps",
		"prepare:content-update": "node scripts/prepare-content-update.js",
		"watch:content": "node scripts/watch-content.js",
		"audit:privacy": "node scripts/audit-repository.js --current",
		"audit:history": "node scripts/audit-repository.js --history",
		"content:migrate:plan": "node scripts/migrate-content.js",
		"content:migrate:apply": "node scripts/migrate-content.js --apply",
		"deploy": "node scripts/deploy.js",
		"release": "node scripts/update-version.js prompt"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/katex": "^0.16.8",
		"@types/node": "^22",
		"autoprefixer": "^10.4.23",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"exifr": "^7.1.3",
		"globals": "^16.5.0",
		"nanoid": "^5.1.11",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sharp": "^0.34.5",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@icons-pack/svelte-simple-icons": "^6.5.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.19",
		"fuse.js": "^7.1.0",
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.11.1",
		"js-yaml": "^4.1.1",
		"katex": "^0.16.28",
		"lucide-svelte": "^0.562.0",
		"qrcode": "^1.5.4",
		"rehype-highlight": "^7.0.2",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"simple-icons": "^16.6.0",
		"tailwind-merge": "^3.4.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	}
}
